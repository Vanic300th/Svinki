    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E \u0438\u043B\u0438 \u0443\u0436\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 787472460
    m_Localized: "\u0427\u0442\u0435\u043D\u0438\u0435 \u043B\u043E\u0431\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 787472461
    m_Localized: "\u0412\u0445\u043E\u0434 \u0432 \u043B\u043E\u0431\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 787472462
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u0438\u0433\u0440\u0443 \u0438\u043B\u0438 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u043B \u0432\u0430\u0441. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0443 \u0445\u043E\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 787472463
    m_Localized: ". \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 EOS."
    m_Metadata:
      m_Items: []
  - m_Id: 787472464
    m_Localized: "EOS \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u0437\u0430 25 \u0441\u0435\u043A\u0443\u043D\u0434. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0441\u0432\u044F\u0437\u044C \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 787472465
    m_Localized: "\u0421\u0435\u0442\u0435\u0432\u0430\u044F \u0438\u0433\u0440\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0432\u0435\u0440\u0441\u0438\u0438 \u0434\u043B\u044F \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430."
