  m_TableData:
  - m_Id: 753917952
    m_Localized: "\u0412\u0430\u0441 \u0441\u0431\u0438\u043B\u0438 \u0441 \u043D\u043E\u0433! \u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u043C\u0441\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278080
    m_Localized: "W/S \u2014 \u0442\u043E\u043B\u043A\u0430\u0442\u044C \u2022 A/D \u2014 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C \u2022 Shift \u2014 \u0431\u0435\u0436\u0430\u0442\u044C\n\u041B\u041A\u041C \u2014 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u2022 E \u2014 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 783278081
    m_Localized: "\u0412\u044B \u0432 \u0442\u0435\u043B\u0435\u0436\u043A\u0435! E / Space \u2014 \u0432\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 783278082
    m_Localized: "\u0422\u0435\u043B\u0435\u0436\u043A\u0430 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 783278083
    m_Localized: "E \u2014 \u0442\u043E\u043B\u043A\u0430\u0442\u044C \u2022 R \u2014 \u0441\u0435\u0441\u0442\u044C \u0432 \u043A\u043E\u0440\u0437\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 783278084
    m_Localized: "\u041B\u041A\u041C \u2014 \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u2022 \u041F\u041A\u041C / E \u2014 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 783278085
    m_Localized: "E \u2014 \u0432\u0437\u044F\u0442\u044C \u043C\u0430\u043D\u0435\u043A\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 783278086
    m_Localized: "E \u2014 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 783278087
    m_Localized: "E \u2014 \u043D\u0430\u0436\u0430\u0442\u044C \xAB\u0413\u043E\u0442\u043E\u0432\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 783278088
    m_Localized: "E \u2014 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C: "
    m_Metadata:
      m_Items: []
  - m_Id: 783278089
    m_Localized: "\u042D\u0442\u043E\u0442 \u0441\u043B\u043E\u0442 \u043E\u0434\u0435\u0436\u0434\u044B \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 783278090
    m_Localized: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 783278091
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u043B\u043E\u0431\u0431\u0438 \u0438\u043B\u0438 \u0432\u043E\u0439\u0434\u0438\u0442\u0435 \u043F\u043E \u043A\u043E\u0434\u0443 \u0434\u0440\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 783278092
    m_Localized: "\u0421\u0432\u0438\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 783278093
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u0438\u0433\u0440\u0443. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0443 \u0445\u043E\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 783278094
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0439\u0434\u0438\u0442\u0435 \u0438\u0437 \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278095
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A EOS\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278096
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 783278097
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 783278098
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A \u0445\u043E\u0441\u0442\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278099
    m_Localized: "\u041F\u043E\u0440\u0442 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u0433\u0440\u044B \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 783278100
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F \u043A \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u0433\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 783278101
    m_Localized: "\u041B\u043E\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0438\u0433\u0440\u0430: \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278102
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043A \u043A\u043D\u043E\u043F\u043A\u0435 \xAB\u0413\u043E\u0442\u043E\u0432\xBB \u0432 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 783278103
    m_Localized: "\u041D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043E\u0446\u0435\u043D\u043A\u0438 \u043E\u0434\u0435\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278104
    m_Localized: "\u0410\u043F\u043B\u043E\u0434\u0438\u0441\u043C\u0435\u043D\u0442\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 783278105
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043D\u0430\u0440\u044F\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 783278106
    m_Localized: "\u0425\u0440\u044E-\u0445\u0440\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 783278107
    m_Localized: "\u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u043E. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0443 \u0445\u043E\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 783278108
    m_Localized: "\u0421\u0432\u044F\u0437\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430. \u041F\u0435\u0440\u0435\u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 (\u0434\u043E 60 \u0441\u0435\u043A\u0443\u043D\u0434)\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278109
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F. \u041C\u043E\u0436\u043D\u043E \u0432\u043E\u0439\u0442\u0438 \u043F\u043E \u043A\u043E\u0434\u0443 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 783278110
    m_Localized: "\u041E\u0446\u0435\u043D\u043A\u0438 \u0437\u0430 \u0440\u0430\u0443\u043D\u0434 "
    m_Metadata:
      m_Items: []
  - m_Id: 783278111
    m_Localized: "\u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430 \u0432\u044B \u0437\u0440\u0438\u0442\u0435\u043B\u044C. \u2190 / \u2192 \u2014 \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u0430; Esc \u2014 \u043C\u0435\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 783278112
    m_Localized: "\u0420\u0430\u0443\u043D\u0434 "
    m_Metadata:
      m_Items: []
  - m_Id: 783278113
    m_Localized: ". Esc \u2014 \u043C\u0435\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 783278114
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 783278115
    m_Localized: ". \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0413\u043E\u0442\u043E\u0432\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 783278116
    m_Localized: "\u041D\u0435\u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278117
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0433\u043E\u0441\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 783278118
    m_Localized: "\u0425\u043E\u0441\u0442 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u043B \u0432\u0430\u0441 \u0438\u0437 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278119
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0443\u0436\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 783278120
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u043A\u0440\u044B\u043B \u0432\u0445\u043E\u0434 \u0434\u043B\u044F \u043D\u043E\u0432\u044B\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 783278121
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043E \u0438\u043B\u0438 \u043C\u0435\u043D\u044F\u0435\u0442 \u0440\u0430\u0443\u043D\u0434. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 783278122
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u043A\u043D\u043E\u043F\u043A\u0435 \xAB\u0413\u043E\u0442\u043E\u0432\xBB \u0432 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 783278123
    m_Localized: "\u0425\u043E\u0441\u0442 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u043B \u0432\u0430\u0441 \u0438\u0437 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278124
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0447\u0430\u0442\u044C \u0440\u0430\u0443\u043D\u0434: \u043E\u0448\u0438\u0431\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F. "
    m_Metadata:
      m_Items: []
  - m_Id: 783278125
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 783278126
    m_Localized: "\u0425\u043E\u0441\u0442 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043A\u043E\u0434 \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 783278127
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u0438\u0433\u0440\u0443. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0443 \u0445\u043E\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 783278128
    m_Localized: "\u0418\u0433\u0440\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430. \u0425\u043E\u0441\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 783278129
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278130
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 783278131
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0439 \u0438\u0433\u0440\u044B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 783278132
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u0447\u043D\u0430\u044F \u0438\u0433\u0440\u0430. Esc \u2014 \u043C\u0435\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 783278133
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A [F]: "
    m_Metadata:
      m_Items: []
  - m_Id: 783278134
    m_Localized: "\u0432\u043A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278135
    m_Localized: "\u0432\u044B\u043A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 783278136
    m_Localized: "\u0423\u043A\u0440\u0430\u0434\u0435\u043D\u043E \u0432\u043E\u0440\u0438\u0448\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 783278137
    m_Localized: "\u0423\u043A\u0440\u0430\u0434\u0435\u043D\u043E: "
    m_Metadata:
      m_Items: []
  - m_Id: 783278138
    m_Localized: "\n\u043D\u0435\u0441\u0451\u0442: "
    m_Metadata:
      m_Items: []
  - m_Id: 783278139
    m_Localized: "\u0412\u0410\u0428 \u041D\u0410\u0420\u042F\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 783278140
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 783278141
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E \u043E\u0434\u0435\u0436\u0434\u0443 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
