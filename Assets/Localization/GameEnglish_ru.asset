      m_Items: []
  - m_Id: 787472453
    m_Localized: "\u041F\u0440\u043E\u0444\u0438\u043B\u044C \u0433\u043E\u0441\u0442\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u0432\u044F\u0437\u044C \u0441 EOS."
