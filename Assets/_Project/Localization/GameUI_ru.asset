  - m_Id: 636477724
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A [F]: \u0432\u043A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 636477725
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A [F]: \u0432\u044B\u043A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 636477726
    m_Localized: "\u0427\u0410\u0422 \xB7 ENTER \u2014 \u041D\u0410\u041F\u0418\u0421\u0410\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477727
    m_Localized: "\u0427\u0430\u0442 \xB7 Enter \u2014 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \xB7 Esc \u2014 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \xB7 \u041A\u043E\u043B\u0435\u0441\u043E \u2014 \u0438\u0441\u0442\u043E\u0440\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 636477728
    m_Localized: "\u0422\u0415\u041B\u0415\u0416\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 636477729
    m_Localized: "\u0421\u043B\u043E\u0436\u0438\u0442\u044C \u043D\u0430\u0434\u0435\u0442\u0443\u044E \u043E\u0434\u0435\u0436\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 636477730
    m_Localized: "G / Esc \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \xB7 \u0412\u0435\u0449\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0432 \u0442\u0435\u043B\u0435\u0436\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 636477731
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0432\u0435\u0449\u044C \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477732
    m_Localized: "\u041D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477733
    m_Localized: "\u0412\u044B\u0433\u0440\u0443\u0437\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477734
    m_Localized: "\u0420\u044F\u0434\u043E\u043C \u043D\u0435\u0442 \u043E\u0434\u0435\u0436\u0434\u044B \u043D\u0430 \u043F\u043E\u043B\u0443. \u041F\u043E\u0434\u0432\u0438\u043D\u044C\u0442\u0435 \u0442\u0435\u043B\u0435\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 636477735
    m_Localized: "\u0417\u0430\u043F\u0440\u043E\u0441 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 636477736
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 636477737
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043C\u0435\u0441\u0442\u043E, \u0441\u043B\u043E\u0442 \u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 636477738
    m_Localized: "\u0412\u042B\u0411\u042B\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 636477739
    m_Localized: "\u0417\u0420\u0418\u0422\u0415\u041B\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477740
    m_Localized: "\u0412\u042B\u0411\u042B\u041B\n\u041D\u0430\u0447\u043D\u0438\u0442\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0443\u043D\u0434, \u0447\u0442\u043E\u0431\u044B \u0438\u0433\u0440\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 636477741
    m_Localized: "\u041D\u0410\u0411\u041B\u042E\u0414\u0415\u041D\u0418\u0415 \xB7 \u0416\u0434\u0451\u043C \u0436\u0438\u0432\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 636477742
    m_Localized: "\u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D \u0412\u042B\u041A\u041B\u042E\u0427\u0415\u041D \xB7 \u041D\u0410\u0411\u041B\u042E\u0414\u0415\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 636477743
    m_Localized: "\u0423\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0419\u0422\u0415 B \xB7 \u0413\u041E\u041B\u041E\u0421 \xB7 25 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477744
    m_Localized: "\u0420\u0410\u0417\u0420\u0415\u0428\u0418\u0422\u0415 \u0414\u041E\u0421\u0422\u0423\u041F \u041A \u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 636477745
    m_Localized: "\u041D\u0423\u0416\u0415\u041D \u0414\u041E\u0421\u0422\u0423\u041F \u041A \u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 636477746
    m_Localized: "\u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D \u041D\u0415 \u041D\u0410\u0419\u0414\u0415\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 636477747
    m_Localized: "\u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D \u041D\u0415\u0414\u041E\u0421\u0422\u0423\u041F\u0415\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 636477748
    m_Localized: "\u0424\u041E\u0420\u041C\u0410\u0422 \u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D\u0410 \u041D\u0415 \u041F\u041E\u0414\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0415\u0422\u0421\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 636477749
    m_Localized: "\u0417\u0410\u041F\u0423\u0421\u041A \u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D\u0410\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 636477750
    m_Localized: "\u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D \u041E\u0422\u041A\u041B\u042E\u0427\u0401\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 636477751
    m_Localized: "\u041D\u0415\u0422 \u0421\u0418\u0413\u041D\u0410\u041B\u0410 \u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 636477752
    m_Localized: "\u041E\u0428\u0418\u0411\u041A\u0410 \u0427\u0422\u0415\u041D\u0418\u042F \u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 636477753
    m_Localized: "\u041C\u0418\u041A\u0420\u041E\u0424\u041E\u041D \u0412\u041A\u041B. \xB7 B \u2014 \u0413\u041E\u0412\u041E\u0420\u0418\u0422\u042C \xB7 25 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477754
    m_Localized: "W/S \u2014 \u0442\u043E\u043B\u043A\u0430\u0442\u044C \u2022 A/D \u2014 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C \u2022 Shift \u2014 \u0431\u0435\u0436\u0430\u0442\u044C\n\u041B\u041A\u041C \u2014 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u2022 E \u2014 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u2022 G \u2014 \u0432\u0435\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 636477755
    m_Localized: "\u0412\u044B \u0432 \u0442\u0435\u043B\u0435\u0436\u043A\u0435! E / Space \u2014 \u0432\u044B\u0439\u0442\u0438 \u2022 G \u2014 \u0432\u0435\u0449\u0438"
    m_Metadata:
