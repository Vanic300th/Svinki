  - m_Id: 636477938
    m_Localized: "Esc \u0432 \u0430\u043B\u044C\u0431\u043E\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 636477939
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0430\u043B\u044C\u0431\u043E\u043C \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 636477940
    m_Localized: "\u0418\u0429\u0418\u0422\u0415 \u041E\u0411\u0425\u041E\u0414\u042B\n\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u0435\u0441\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u043E\u0442\u0434\u0435\u043B\u044B, \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u0438 \u0441\u043A\u0440\u044B\u0442\u044B\u0435 \u043F\u043E\u043B\u043A\u0438. \u0418\u0449\u0438\u0442\u0435 \u0437\u0430 \u0432\u0438\u0442\u0440\u0438\u043D\u0430\u043C\u0438 \u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u0448\u043A\u0430\u0444\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 636477941
    m_Localized: "\u041A\u0410\u0420\u0422\u0410 \u0420\u042F\u0414\u041E\u041C\n\u041C\u0438\u043D\u0438\u043A\u0430\u0440\u0442\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0438 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u043E\u0442\u0434\u0435\u043B\u044B. \u041F\u0440\u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0438 \u043E\u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u043C \u0438\u0433\u0440\u043E\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 636477942
    m_Localized: "\u0426\u0412\u0415\u0422\u0410 \u0418\u0413\u0420\u041E\u041A\u041E\u0412\n\u0421\u0442\u0440\u0435\u043B\u043A\u0430 \u0438 \u043D\u0438\u043A \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u0435\u043D\u044B \u043E\u0434\u043D\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430. \u0426\u0432\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u043C\u0435\u0436\u0434\u0443 \u0440\u0430\u0443\u043D\u0434\u0430\u043C\u0438. \u0422\u0435\u043B\u0435\u0436\u043A\u0438 \u2014 \u0436\u0451\u043B\u0442\u044B\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u044B. \xAB\u0413\u043E\u0442\u043E\u0432\xBB \u2014 \u0437\u0435\u043B\u0451\u043D\u0430\u044F R."
    m_Metadata:
      m_Items: []
  - m_Id: 636477943
    m_Localized: "\u0412\u0410\u0428\u0410 \u0421\u0412\u0418\u041D\u041A\u0410 \u0418 \u0412\u0415\u0429\u0418\n\u0421\u0432\u0438\u043D\u043A\u0430 \u0441\u0431\u043E\u043A\u0443 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442 \u0432\u0430\u0448 \u043E\u0431\u043B\u0438\u043A \u0438 \u043D\u0430\u0440\u044F\u0434. \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u0432\u0435\u0449\u044C \u0434\u043B\u044F \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 E; \u043F\u0440\u0438\u0441\u044F\u0434\u044C\u0442\u0435 \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u043D\u0430 \u043D\u0438\u0436\u043D\u0438\u0445 \u043F\u043E\u043B\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 636477944
    m_Localized: "\u0421\u041E\u0411\u0415\u0420\u0418\u0422\u0415 \u041E\u0411\u0420\u0410\u0417\n\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439 \u0443\u0431\u043E\u0440, \u0432\u0435\u0440\u0445, \u0431\u0440\u044E\u043A\u0438 \u0438 \u043E\u0431\u0443\u0432\u044C. \u0412 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u043B\u043E\u0442\u0430. \u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u0435 \u0432\u0435\u0449\u044C, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C \u0435\u0451 \u0441\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 636477945
    m_Localized: "\u041D\u041E\u0412\u042B\u0419 \u0420\u0410\u0423\u041D\u0414 \u2014 \u041D\u041E\u0412\u042B\u0419 \u041F\u041E\u0418\u0421\u041A\n\u041E\u0434\u0435\u0436\u0434\u0430 \u043C\u0435\u043D\u044F\u0435\u0442 \u0442\u0430\u0439\u043D\u0438\u043A\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0443\u043D\u0434. \u041C\u0430\u043D\u0435\u043A\u0435\u043D\u044B, \u0442\u0435\u043B\u0435\u0436\u043A\u0438 \u0438 \u0438\u0433\u0440\u0443\u0448\u043A\u0438 \u0442\u043E\u0436\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432 \u043D\u043E\u0432\u044B\u0445 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 636477946
    m_Localized: "\u0412\u0415\u0420\u041D\u0418\u0422\u0415\u0421\u042C \u041A\u041E \u0412\u0425\u041E\u0414\u0423\n\u041A\u043D\u043E\u043F\u043A\u0430 \xAB\u0413\u043E\u0442\u043E\u0432\xBB \u043D\u0430 \u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u0435\u043D\u0435 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B. \u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0432\u043C\u0435\u0441\u0442\u0435. \u0423\u0445\u043E\u0434 \u0438\u0437 \u0437\u043E\u043D\u044B \u0438\u043B\u0438 \u0441\u043C\u0435\u043D\u0430 \u043D\u0430\u0440\u044F\u0434\u0430 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 636477947
    m_Localized: "\u041F\u041E\u041A\u0410\u0417 \u041C\u041E\u0414\n\u0412\u0441\u0435 \u0432\u0438\u0434\u044F\u0442 \u043F\u043E\u0434\u0438\u0443\u043C \u0438 \u043E\u0446\u0435\u043D\u043A\u0438 \u043D\u0430\u0440\u044F\u0434\u043E\u0432. \u0421\u0442\u0430\u0440\u0430\u044F \u0438 \u043D\u043E\u0432\u0430\u044F \u043E\u0434\u0435\u0436\u0434\u0430 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435. 16 \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0441\u043E\u0447\u0435\u0442\u0430\u0442\u044C \u0446\u0432\u0435\u0442\u0430 \u0438 \u0443\u0437\u043E\u0440\u044B. \u0412\u044B\u0431\u044B\u0432\u0448\u0438\u0435 \u0441\u0432\u0438\u043D\u043A\u0438 \u2014 \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 636477948
    m_Localized: "\u0422\u0420\u0418 \u041E\u0411\u0429\u0418\u0415 \u0422\u0415\u041B\u0415\u0416\u041A\u0418\n\u0412 \u0442\u0435\u043B\u0435\u0436\u043A\u0435 \u043E\u0434\u0438\u043D \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u0438 \u043E\u0434\u0438\u043D \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440. \u0421\u0442\u0435\u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0435\u0451. \u0417\u0430\u043F\u0443\u0449\u0435\u043D\u043D\u0430\u044F \u0442\u0435\u043B\u0435\u0436\u043A\u0430 \u043C\u043E\u0436\u0435\u0442 \u0441\u0431\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0432\u0438\u043D\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 636477949
    m_Localized: "\u0412\u041E\u0421\u0415\u041C\u042C \u041C\u0415\u0421\u0422 \u0414\u041B\u042F \u0412\u0415\u0429\u0415\u0419\n\u0412 \u043A\u043E\u0440\u0437\u0438\u043D\u0435 \u043C\u043E\u0436\u043D\u043E \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E \u043E\u0434\u0435\u0436\u0434\u0443, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0432\u0435\u0449\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043B\u043E\u0442\u0430. \u041F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0449\u0438, \u043F\u043E\u043A\u0430 \u0442\u0435\u043B\u0435\u0436\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0438\u043B\u0438 \u0435\u0434\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 636477950
    m_Localized: "\u041E\u0411\u0415\u0417\u042C\u042F\u041D\u0410 \u0414\u041B\u042F \u041A\u0410\u0416\u0414\u041E\u0413\u041E\n\u0418\u0433\u0440\u0443\u0448\u043A\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445. \u041F\u043E\u0441\u043B\u0435 \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0438\u0433\u0440\u0443\u0448\u043A\u0430 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442, \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u0443\u0434\u0430\u0440\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u0430. \u041F\u0440\u043E\u043C\u0430\u0445 \u0435\u0451 \u043D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 636477951
    m_Localized: "\u041E\u0413\u041B\u0423\u0428\u0415\u041D\u0418\u0415 \u041D\u0410 30 \u0421\u0415\u041A\u0423\u041D\u0414\n\u0423\u0434\u0430\u0440 \u0438\u0433\u0440\u0443\u0448\u043A\u043E\u0439 \u0440\u043E\u043D\u044F\u0435\u0442 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u0430 \u043D\u0430 30 \u0441\u0435\u043A\u0443\u043D\u0434. \u041D\u0443\u0436\u043D\u044B \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435 \u0440\u0443\u043A\u0438. \u041D\u0435\u043B\u044C\u0437\u044F \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0438\u0433\u0440\u0443\u0448\u043A\u0443, \u043F\u043E\u043A\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0435 \u0442\u0435\u043B\u0435\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 636477952
    m_Localized: "\u0413\u041E\u041B\u041E\u0421 \u041F\u041E \u0420\u0410\u0421\u0421\u0422\u041E\u042F\u041D\u0418\u042E\n\u0420\u044F\u0434\u043E\u043C \u0433\u043E\u043B\u043E\u0441 \u0433\u0440\u043E\u043C\u043A\u0438\u0439, \u0430 \u043A 25 \u043C\u0435\u0442\u0440\u0430\u043C \u0437\u0430\u0442\u0438\u0445\u0430\u0435\u0442. \u041C\u0438\u043A\u0440\u043E\u0444\u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442, \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0430 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F B. \u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435 \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 636477953
    m_Localized: "\u0421\u041B\u0415\u0414\u0418\u0422\u0415 \u0417\u0410 \u041C\u0410\u041D\u0415\u041A\u0415\u041D\u0410\u041C\u0418\n\u0410\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u043C\u0430\u043D\u0435\u043A\u0435\u043D \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442, \u043F\u043E\u043A\u0430 \u0435\u0433\u043E \u0432\u0438\u0434\u0438\u0442 \u0436\u0438\u0432\u043E\u0439 \u0438\u0433\u0440\u043E\u043A. \u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435\u0441\u044C, \u043A\u0442\u043E \u0441\u043B\u0435\u0434\u0438\u0442, \u043F\u043E\u043A\u0430 \u0434\u0440\u0443\u0437\u044C\u044F \u0438\u0449\u0443\u0442 \u0432\u0435\u0449\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 636477954
    m_Localized: "\u0414\u0412\u0410 \u0423\u0414\u0410\u0420\u0410\n\u041F\u0435\u0440\u0432\u044B\u0439 \u0443\u0434\u0430\u0440 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0441 \u043D\u043E\u0433. \u0412\u0442\u043E\u0440\u043E\u0439 \u2014 \u0432\u044B\u0432\u043E\u0434\u0438\u0442 \u0438\u0437 \u0438\u0433\u0440\u044B \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430: \u043E\u0434\u0435\u0436\u0434\u0430 \u043F\u0430\u0434\u0430\u0435\u0442, \u0430 \u0432\u044B \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0435 \u0437\u0430 \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 636477955
    m_Localized: "\u0412\u041E\u0420\u0418\u0428\u041A\u0418 \u0418 \u0427\u0410\u0422\n\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0432\u043E\u0440\u0438\u0448\u043A\u0438 \u0443\u043D\u043E\u0441\u044F\u0442 \u043E\u0434\u0435\u0436\u0434\u0443 \u0432 \u0433\u043D\u0435\u0437\u0434\u043E. \u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0432\u0438\u0434\u043D\u044B \u043D\u0430\u0434 \u0441\u0432\u0438\u043D\u043A\u0430\u043C\u0438 \u0438 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0441\u0431\u043E\u043A\u0443. \u042D\u043C\u043E\u0446\u0438\u044F\u043C \u043D\u0443\u0436\u043D\u044B \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435 \u0440\u0443\u043A\u0438. \u041F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u0433\u043E\u043B\u043E\u0441 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 636477956
    m_Localized: "\u041A\u0410\u041C\u0415\u0420\u0410 \u0412\u0421\u0415\u0413\u0414\u0410 \u0421 \u0412\u0410\u041C\u0418\n\u041A\u0430\u0436\u0434\u0430\u044F \u0441\u0432\u0438\u043D\u043A\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441 \u043A\u0430\u043C\u0435\u0440\u043E\u0439. K \u2014 \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u0438\u043B\u0438 \u0443\u0431\u0440\u0430\u0442\u044C, \u0438\u0441\u043A\u0430\u0442\u044C \u0435\u0451 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E. \u0423\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u0430\u043C\u0435\u0440\u0443, \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C \u0438\u0433\u0440\u0443\u0448\u043A\u0443 \u0438\u043B\u0438 \u0442\u0435\u043B\u0435\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 636477957
    m_Localized: "\u0421\u041D\u0418\u041C\u041A\u0418 \u0414\u0415\u0428\u0401\u0412\u041E\u0419 \u041A\u0410\u041C\u0415\u0420\u042B\n\u041D\u0430 \u0444\u043E\u0442\u043E \u043A\u0440\u0443\u043F\u043D\u044B\u0435 \u043F\u0438\u043A\u0441\u0435\u043B\u0438, \u0448\u0443\u043C \u0438 \u0441\u0436\u0430\u0442\u0438\u0435. \u0420\u0430\u043C\u043A\u0430 \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0441\u043D\u0438\u043C\u043A\u0430. \u041C\u0435\u0436\u0434\u0443 \u0441\u043D\u0438\u043C\u043A\u0430\u043C\u0438 \u043D\u0443\u0436\u043D\u0430 1 \u0441\u0435\u043A\u0443\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 636477958
    m_Localized: "\u0410\u041B\u042C\u0411\u041E\u041C \u0420\u0410\u0423\u041D\u0414\u0410\n\u041B\u041A\u041C \u2014 \u0441\u043D\u044F\u0442\u044C; P \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 12 \u0444\u043E\u0442\u043E. \u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0432 \u043A\u0430\u0434\u0440 \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442. \u0410\u043B\u044C\u0431\u043E\u043C\u044B \u0432\u0441\u0435\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0432 \u043E\u0446\u0435\u043D\u043A\u0430\u0445, \u0434\u0430\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 636477959
    m_Localized: "\u041C\u0410\u041D\u0415\u041A\u0415\u041D\u042B \u041C\u0410\u0413\u0410\u0417\u0418\u041D\u0410\n40 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0444\u0438\u0433\u0443\u0440 \u0438 8 \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0445 \u043C\u0435\u043D\u044F\u044E\u0442 \u043C\u0435\u0441\u0442\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0443\u043D\u0434. \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u043C\u043E\u0436\u043D\u043E \u043D\u043E\u0441\u0438\u0442\u044C \u0438 \u0431\u0440\u043E\u0441\u0430\u0442\u044C. \u0412\u0441\u043F\u044B\u0448\u043A\u0430 \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442. \u0412\u0445\u043E\u0434 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 636477960
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0443\u044E \u0432\u0435\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 636477961
    m_Localized: "\u0423\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0419\u0422\u0415 V \xB7 \u042D\u041C\u041E\u0426\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 636477962
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 V \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \xB7 Esc \u2014 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
