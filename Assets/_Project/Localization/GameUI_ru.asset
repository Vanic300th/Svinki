    m_Localized: "\u041B\u0438\u0441\u0442\u0430\u0442\u044C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0432 \u0430\u043B\u044C\u0431\u043E\u043C\u0435"
    m_Metadata:
