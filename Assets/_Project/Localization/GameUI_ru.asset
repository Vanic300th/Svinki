    m_Localized: "\u0425\u043E\u0441\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0441\u0435\u0445 \u0432 \u043B\u043E\u0431\u0431\u0438"
